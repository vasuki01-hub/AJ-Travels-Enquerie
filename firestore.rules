rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function bootstrapPath() {
      return /databases/$(database)/documents/settings/bootstrap;
    }

    function activeStaff() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.status == 'active'
        && get(userPath(request.auth.uid)).data.role in ['admin', 'employee'];
    }

    function isAdmin() {
      return activeStaff()
        && get(userPath(request.auth.uid)).data.role == 'admin';
    }

    function inquiryPath(id) {
      return /databases/$(database)/documents/inquiries/$(id);
    }

    function bookingPath(id) {
      return /databases/$(database)/documents/bookings/$(id);
    }

    function isCount(value) {
      return value is int && value >= 0 && value <= 1000;
    }

    function isMoney(value) {
      return (value is int || value is float)
        && value >= 0 && value <= 100000000;
    }

    function isProfit(value) {
      return (value is int || value is float)
        && value >= -100000000 && value <= 100000000;
    }

    function emailMatchesAuth(email) {
      return email is string
        && email.size() > 0
        && email.size() <= 254
        && (
          request.auth.token.get('email', '') == ''
          || email.lower() == request.auth.token.email.lower()
        );
    }

    function isBootstrapAdminEmail(email) {
      return email is string
        && (
          email.lower() == 'pgboss07@gmail.com'
          || (exists(bootstrapPath())
            && get(bootstrapPath()).data.adminEmail is string
            && email.lower() == get(bootstrapPath()).data.adminEmail.lower())
        );
    }

    function validTravelRecord(data, expectedType) {
      return data.keys().hasOnly([
          'recordType', 'status', 'customerName', 'passengers', 'email',
          'contactNo', 'enquiryDate', 'bookingDate', 'departureDate',
          'origin', 'destination', 'systemPnr', 'airlinePnr', 'ticketNumber',
          'sourceEnquiryId', 'linkedBookingId', 'adultCount', 'youthCount',
          'childCount', 'infantCount', 'netFareAdult', 'netFareYouth',
          'netFareChild', 'netFareInfant', 'totalNet', 'clientFareAdult',
          'clientFareYouth', 'clientFareChild', 'clientFareInfant',
          'totalFareQuoted', 'profit', 'receivedPayment', 'paymentStatus',
          'paymentDate', 'followUpDate', 'paymentMode', 'issuedFrom', 'remarks',
          'customFields', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'
        ])
        && data.recordType == expectedType
        && data.status is string
        && ((expectedType == 'enquiry'
          && data.status in ['new', 'contacted', 'quoted', 'follow-up', 'converted', 'lost'])
          || (expectedType == 'booking'
          && data.status in ['confirmed', 'ticketed', 'completed', 'cancelled']))
        && data.customerName is string && data.customerName.size() <= 180
        && data.passengers is string && data.passengers.size() <= 500
        && data.email is string && data.email.size() <= 254
        && data.contactNo is string && data.contactNo.size() <= 80
        && data.enquiryDate is string && data.enquiryDate.size() <= 20
        && data.bookingDate is string && data.bookingDate.size() <= 20
        && data.departureDate is string && data.departureDate.size() <= 20
        && data.origin is string && data.origin.size() <= 120
        && data.destination is string && data.destination.size() <= 120
        && data.systemPnr is string && data.systemPnr.size() <= 120
        && data.airlinePnr is string && data.airlinePnr.size() <= 120
        && data.ticketNumber is string && data.ticketNumber.size() <= 180
        && isCount(data.adultCount)
        && isCount(data.youthCount)
        && isCount(data.childCount)
        && isCount(data.infantCount)
        && isMoney(data.netFareAdult)
        && isMoney(data.netFareYouth)
        && isMoney(data.netFareChild)
        && isMoney(data.netFareInfant)
        && isMoney(data.totalNet)
        && isMoney(data.clientFareAdult)
        && isMoney(data.clientFareYouth)
        && isMoney(data.clientFareChild)
        && isMoney(data.clientFareInfant)
        && isMoney(data.totalFareQuoted)
        && isProfit(data.profit)
        && isMoney(data.receivedPayment)
        && data.paymentStatus in ['pending', 'partially_paid', 'paid']
        && data.paymentDate is string && data.paymentDate.size() <= 20
        && (!data.keys().hasAny(['followUpDate'])
          || (data.followUpDate is string && data.followUpDate.size() <= 20))
        && data.paymentMode is string && data.paymentMode.size() <= 80
        && data.issuedFrom is string && data.issuedFrom.size() <= 160
        && data.remarks is string && data.remarks.size() <= 5000
        && data.customFields is map && data.customFields.size() <= 50
        && data.createdBy is string && data.createdBy.size() <= 160
        && data.updatedBy is string && data.updatedBy.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['sourceEnquiryId'])
          || data.sourceEnquiryId == null || data.sourceEnquiryId is string)
        && (!data.keys().hasAny(['linkedBookingId'])
          || data.linkedBookingId == null || data.linkedBookingId is string);
    }

    function linkedBookingExistsNow(inquiryId, bookingId) {
      return bookingId is string
        && bookingId == 'linked_' + inquiryId
        && exists(bookingPath(bookingId))
        && get(bookingPath(bookingId)).data.recordType == 'booking'
        && get(bookingPath(bookingId)).data.sourceEnquiryId == inquiryId;
    }

    function linkedBookingExistsAfter(inquiryId, bookingId) {
      return bookingId is string
        && bookingId == 'linked_' + inquiryId
        && existsAfter(bookingPath(bookingId))
        && getAfter(bookingPath(bookingId)).data.recordType == 'booking'
        && getAfter(bookingPath(bookingId)).data.sourceEnquiryId == inquiryId;
    }

    function bookingCreateLinkIsValid(bookingId, data) {
      let sourceId = data.get('sourceEnquiryId', null);
      return sourceId == null || sourceId == ''
        || (sourceId is string
          && bookingId == 'linked_' + sourceId
          && exists(inquiryPath(sourceId))
          && get(inquiryPath(sourceId)).data.recordType == 'enquiry'
          && get(inquiryPath(sourceId)).data.status != 'lost'
          && get(inquiryPath(sourceId)).data.status != 'converted'
          && get(inquiryPath(sourceId)).data.get('linkedBookingId', null) == null
          && linkedBookingExistsAfter(sourceId, bookingId)
          && getAfter(inquiryPath(sourceId)).data.status == 'converted'
          && getAfter(inquiryPath(sourceId)).data.linkedBookingId == bookingId);
    }

    function bookingUpdateLinkIsValid(bookingId, data) {
      let sourceId = data.get('sourceEnquiryId', null);
      return sourceId == null || sourceId == ''
        || (sourceId is string
          && bookingId == 'linked_' + sourceId
          && exists(inquiryPath(sourceId))
          && get(inquiryPath(sourceId)).data.status == 'converted'
          && get(inquiryPath(sourceId)).data.linkedBookingId == bookingId);
    }

    function inquiryCanBeDeleted(data) {
      let bookingId = data.get('linkedBookingId', null);
      return bookingId == null
        || (bookingId is string && !exists(bookingPath(bookingId)));
    }

    function inquiryUpdateIsValid(inquiryId, data) {
      let oldData = resource.data;
      let oldBookingId = oldData.get('linkedBookingId', null);
      let newBookingId = data.get('linkedBookingId', null);
      let unchangedLink = newBookingId == oldBookingId;
      let unlinkAfterBookingDelete = oldBookingId is string
        && oldBookingId == 'linked_' + inquiryId
        && exists(bookingPath(oldBookingId))
        && get(bookingPath(oldBookingId)).data.sourceEnquiryId == inquiryId
        && !existsAfter(bookingPath(oldBookingId));

      return activeStaff()
        && validTravelRecord(data, 'enquiry')
        && data.createdAt == oldData.createdAt
        && (
          (oldData.status != 'converted'
            && data.status != 'converted'
            && unchangedLink
            && data.updatedBy == request.auth.uid)
          || (oldData.status != 'converted'
            && data.status == 'converted'
            && oldBookingId == null
            && linkedBookingExistsAfter(inquiryId, newBookingId)
            && getAfter(bookingPath(newBookingId)).data.createdBy == request.auth.uid)
          || (oldData.status == 'converted'
            && data.status == 'converted'
            && unchangedLink
            && linkedBookingExistsNow(inquiryId, newBookingId)
            && data.updatedBy == request.auth.uid)
          || (oldData.status == 'converted'
            && data.status == 'contacted'
            && newBookingId == null
            && unlinkAfterBookingDelete)
        );
    }

    function userProfileCreateIsValid(uid, data) {
      return signedIn()
        && request.auth.uid == uid
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'phone', 'role', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'uid', 'displayName', 'email', 'phone', 'role', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 160
        && emailMatchesAuth(data.email)
        && data.phone is string && data.phone.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (
          (data.role == 'pending' && data.status == 'pending')
          || (data.role == 'admin'
            && data.status == 'active'
            && isBootstrapAdminEmail(data.email))
        );
    }

    function validAttendance(data) {
      return data.keys().hasOnly([
          'uid', 'displayName', 'email', 'date', 'status',
          'loginAt', 'logoutAt', 'note', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.displayName is string && data.displayName.size() <= 160
        && data.email is string && data.email.size() <= 254
        && data.date is string
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.status in [
          'present', 'paid_leave', 'unpaid_leave', 'festival_leave',
          'sick_leave', 'half_day', 'absent'
        ]
        && (data.loginAt == null || data.loginAt is timestamp)
        && (data.logoutAt == null || data.logoutAt is timestamp)
        && data.note is string && data.note.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function portalSettingsAreValid(data) {
      return data.keys().hasOnly([
          'agencyName', 'logoUrl', 'currency', 'accentColor', 'modules',
          'customFields', 'updatedAt', 'updatedBy'
        ])
        && (!data.keys().hasAny(['agencyName'])
          || (data.agencyName is string && data.agencyName.size() <= 90))
        && (!data.keys().hasAny(['logoUrl'])
          || (data.logoUrl is string && data.logoUrl.size() <= 500))
        && (!data.keys().hasAny(['currency'])
          || data.currency in ['GBP', 'EUR', 'USD'])
        && (!data.keys().hasAny(['accentColor'])
          || (data.accentColor is string && data.accentColor.matches('^#[0-9A-Fa-f]{6}$')))
        && (!data.keys().hasAny(['modules'])
          || (data.modules is map
            && data.modules.keys().hasOnly(['dashboard', 'enquiries', 'bookings', 'reports'])
            && (!data.modules.keys().hasAny(['dashboard']) || data.modules.dashboard is bool)
            && (!data.modules.keys().hasAny(['enquiries']) || data.modules.enquiries is bool)
            && (!data.modules.keys().hasAny(['bookings']) || data.modules.bookings is bool)
            && (!data.modules.keys().hasAny(['reports']) || data.modules.reports is bool)))
        && (!data.keys().hasAny(['customFields'])
          || (data.customFields is list && data.customFields.size() <= 50))
        && (!data.keys().hasAny(['updatedAt']) || data.updatedAt is timestamp)
        && (!data.keys().hasAny(['updatedBy'])
          || (data.updatedBy is string && data.updatedBy == request.auth.uid));
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if userProfileCreateIsValid(uid, request.resource.data);
      allow update: if (isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'status', 'approvedAt', 'approvedBy', 'updatedAt'
        ])
        && request.resource.data.role in ['pending', 'employee', 'admin', 'disabled']
        && request.resource.data.status in ['pending', 'active', 'disabled']
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['approvedAt'])
          || request.resource.data.approvedAt is timestamp)
        && (!request.resource.data.keys().hasAny(['approvedBy'])
          || request.resource.data.approvedBy == request.auth.uid)
        && (uid != request.auth.uid
          || (request.resource.data.role == 'admin'
            && request.resource.data.status == 'active')))
        || (signedIn()
          && request.auth.uid == uid
          && resource.data.uid == uid
          && resource.data.role == 'pending'
          && resource.data.status == 'pending'
          && request.resource.data.uid == uid
          && request.resource.data.role == 'pending'
          && request.resource.data.status == 'pending'
          && emailMatchesAuth(request.resource.data.email)
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 160
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 80
          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'phone', 'createdAt', 'updatedAt'
          ]))
        || (signedIn()
          && request.auth.uid == uid
          && resource.data.role == 'pending'
          && resource.data.status == 'pending'
          && isBootstrapAdminEmail(request.resource.data.email)
          && request.resource.data.uid == uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == 'admin'
          && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'status', 'updatedAt'
          ])
          && request.resource.data.updatedAt is timestamp);
      allow delete: if false;
    }

    match /attendance/{entryId} {
      allow get: if activeStaff()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin()
        || (activeStaff() && resource.data.uid == request.auth.uid);
      allow create: if activeStaff()
        && request.resource.data.uid == request.auth.uid
        && entryId == request.auth.uid + '_' + request.resource.data.date
        && validAttendance(request.resource.data);
      allow update: if activeStaff()
        && validAttendance(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.date == resource.data.date
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (resource.data.uid == request.auth.uid
            && request.resource.data.uid == request.auth.uid)
          || isAdmin()
        );
      allow delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow get, list: if activeStaff();
      allow create: if activeStaff()
        && validTravelRecord(request.resource.data, 'enquiry')
        && request.resource.data.status != 'converted'
        && request.resource.data.get('sourceEnquiryId', null) == null
        && request.resource.data.get('linkedBookingId', null) == null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;
      allow update: if inquiryUpdateIsValid(inquiryId, request.resource.data);
      allow delete: if activeStaff() && inquiryCanBeDeleted(resource.data);
    }

    match /bookings/{bookingId} {
      allow get, list: if activeStaff();
      allow create: if activeStaff()
        && validTravelRecord(request.resource.data, 'booking')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && bookingCreateLinkIsValid(bookingId, request.resource.data);
      allow update: if activeStaff()
        && validTravelRecord(request.resource.data, 'booking')
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('sourceEnquiryId', null)
          == resource.data.get('sourceEnquiryId', null)
        && request.resource.data.updatedBy == request.auth.uid
        && bookingUpdateLinkIsValid(bookingId, request.resource.data);
      allow delete: if activeStaff()
        && (resource.data.get('sourceEnquiryId', null) == null
          || resource.data.get('sourceEnquiryId', null) == ''
          || (resource.data.sourceEnquiryId is string
            && resource.data.sourceEnquiryId.size() > 0
            && exists(inquiryPath(resource.data.sourceEnquiryId))
            && get(inquiryPath(resource.data.sourceEnquiryId)).data.status == 'converted'
            && get(inquiryPath(resource.data.sourceEnquiryId)).data.linkedBookingId == bookingId
            && existsAfter(inquiryPath(resource.data.sourceEnquiryId))
            && getAfter(inquiryPath(resource.data.sourceEnquiryId)).data.status == 'contacted'
            && getAfter(inquiryPath(resource.data.sourceEnquiryId)).data.linkedBookingId == null));
    }

    match /settings/{settingId} {
      allow get: if (settingId == 'bootstrap' && signedIn())
        || (settingId == 'portal' && activeStaff());
      allow list: if false;
      allow create, update: if isAdmin()
        && settingId == 'portal'
        && portalSettingsAreValid(request.resource.data);
      allow delete: if false;
    }
  }
}
