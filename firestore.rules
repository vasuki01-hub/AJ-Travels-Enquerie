rules_version = '2';

// Firestore Security Rules for AJ Tours & Travel
// Protects database while allowing proper collection listeners for signed-in staff.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerEmail() {
      return isSignedIn()
        && request.auth.token.get('email', '').lower() == 'pgboss07@gmail.com';
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAdmin() {
      return isSignedIn()
        && (
          isOwnerEmail()
          || (exists(userDoc()) && get(userDoc()).data.get('role', '') == 'admin')
        );
    }

    // User profiles: allow read so staff listings & assignments work smoothly
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Account self-deletion or admin deletion
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Contact lookup for phone/email login resolution
    match /contactIndex/{contactId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Inquiries: data isolation handled client-side in Storage.getInquiries()
    match /inquiries/{inquiryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Bookings: data isolation handled client-side in Storage.getBookings()
    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Employees legacy collection if referenced
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Activity & Audit logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
